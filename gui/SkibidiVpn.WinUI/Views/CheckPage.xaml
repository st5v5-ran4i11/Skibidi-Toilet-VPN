<Page x:Class="SkibidiVpn.WinUI.Views.CheckPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Padding="22" Spacing="14"><TextBlock Text="Проверка" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="Ожидание backend"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="START" Click="Start_Click"/><Button Content="PAUSE" Click="Pause_Click"/><Button Content="CONTINUE" Click="Continue_Click"/><Button Content="STOP" Click="Stop_Click"/></StackPanel><ListView x:Name="StagesList" MinHeight="160"><ListView.ItemTemplate><DataTemplate><Border Padding="10" Margin="0,3" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><StackPanel Spacing="5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding State}"/></Grid><ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}" Height="5"/><TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.8"/></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView><TextBlock Text="Счётчики поступают из Go Progress Manager. COLLECTOR / PROCESSOR / PARSER объединены в одну визуальную стадию с деталями внутри. Отдельный RANKING stage в Progress Manager не публикуется, поэтому фиктивный счётчик не отображается." TextWrapping="Wrap" Opacity="0.75"/></StackPanel></ScrollViewer>
</Page>
